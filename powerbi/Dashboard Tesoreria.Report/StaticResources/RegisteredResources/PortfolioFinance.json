{
  "name": "Portfolio Finance",
  "dataColors": [
    "#2E5C8A",
    "#E0A100",
    "#3A8D8C",
    "#1B2A41",
    "#9DB7D5",
    "#7A5C99",
    "#C0392B",
    "#1E8E5A",
    "#8A94A6",
    "#D35400"
  ],
  "foreground": "#22303C",
  "background": "#FFFFFF",
  "tableAccent": "#1B2A41",
  "good": "#1E8E5A",
  "neutral": "#E0A100",
  "bad": "#C0392B",
  "textClasses": {
    "callout": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2A41"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#22303C"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#22303C"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#22303C"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E7EC"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 11,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#22303C"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontSize": 9
          }
        ]
      }
    }
  }
}