model Model
	culture: it-IT
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: it-IT
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Calendar","Site","BankAccount","Counterparty","CashCategory","FactBankTransaction","FactBankBalanceDaily","FactARInvoice","FactAPInvoice","FactCashForecast","TreasuryParameter","AlertList"]

annotation PBI_ProTooling = ["DevMode"]

ref table Calendar
ref table Site
ref table BankAccount
ref table Counterparty
ref table CashCategory
ref table FactBankTransaction
ref table FactBankBalanceDaily
ref table FactARInvoice
ref table FactAPInvoice
ref table FactCashForecast
ref table TreasuryParameter
ref table AlertList

ref cultureInfo it-IT

